# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

tocon "Setting root password..."

if [ ! -d "/storage/.cache/samba" ]
then
  mkdir -p /storage/.cache/samba
  touch /storage/.cache/samba/smbpasswd
fi

ROTATION=$(get_setting rotate.root.password)
if [ "${ROTATION}" == "0" ]
then
  ROOTPASS=$(get_setting root.password)
  # setrootpass takes ~1 s (shadow, samba and syncthing). Skip it when the
  # password in /storage/.cache/shadow already matches and samba and
  # syncthing were set up by a previous run.
  CURRENT=$(awk -F: '/^root:/ {print $2}' /storage/.cache/shadow 2>/dev/null)
  SALT=$(echo "${CURRENT}" | cut -d'$' -f3)
  if [ -n "${SALT}" ] && \
     [ "$(cryptpw -m sha512 -S "${SALT}" "${ROOTPASS}" 2>/dev/null)" = "${CURRENT}" ] && \
     grep -q "^root:" /storage/.cache/samba/smbpasswd 2>/dev/null && \
     grep -q "<user>root</user>" /storage/.config/syncthing/config.xml 2>/dev/null
  then
    exit 0
  fi
  setrootpass "${ROOTPASS}"
  exit 0
fi

# Randomly generate the root password on startup
ROOTPASS=$(openssl rand -base64 10 2>/dev/null | sed "s#==##g")

/usr/bin/setrootpass "${ROOTPASS}"
